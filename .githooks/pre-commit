#!/bin/sh
# 커밋 전 검사 2종.
#
#   1) 은수님 로컬 전용 파일이 섞였는지  (아래 인라인)
#   2) CP949 왕복 손실 문자             (check_encoding.py)
#
# 어느 쪽이든 걸리면 커밋을 막는다.

# ---------------------------------------------------------------- 1) 로컬 전용 파일
#
# 은수님이 의도적으로 미커밋 상태로 두는 파일들이다. 상세는
# docs/상시 점검 대장.md §1 «참고 - 미커밋 유지 중인 은수님 파일».
#
# 2026-08-06 신설. `git add src/` 처럼 디렉터리를 통째로 지정하다가
# nvmupdate.bat 과 tests/diff/ 가 두 번 섞여 들어갔다. 절차로 지키려다
# 두 번 어겼으므로 장치로 막는다.

LOCAL_ONLY='^(src/4__eeprom/nvmupdate\.bat|tests/diff/|1__cfx\.elf)'

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
hits="$(printf '%s\n' "$staged" | grep -E "$LOCAL_ONLY")"

if [ -n "$hits" ]; then
    echo "[pre-commit] 은수님 로컬 전용 파일이 스테이지에 있습니다:" >&2
    printf '  %s\n' $hits >&2
    echo "" >&2
    echo "  이 파일들은 커밋하지 않습니다(장비 설정·빌드 부산물·비교본)." >&2
    echo "  아래로 내린 뒤 다시 커밋하세요:" >&2
    echo "" >&2
    printf '    git restore --staged %s\n' $hits >&2
    echo "" >&2
    echo "  의도적으로 커밋해야 한다면 --no-verify 로 우회할 수 있습니다." >&2
    exit 1
fi

# ---------------------------------------------------------------- 2) 인코딩
# python 이 없으면 검사를 건너뛴다(커밋은 통과) - 훅 부재로 작업이 막히지 않도록.
if command -v python >/dev/null 2>&1; then
    exec python "$(dirname "$0")/check_encoding.py"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 "$(dirname "$0")/check_encoding.py"
else
    echo "[pre-commit] python 없음 - 인코딩 검사 건너뜀"
    exit 0
fi
