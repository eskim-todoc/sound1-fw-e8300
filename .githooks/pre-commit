#!/bin/sh
# CP949 왕복 손실 문자 차단 훅.
# python 이 없으면 검사를 건너뛴다(커밋은 통과) — 훅 부재로 작업이 막히지 않도록.
if command -v python >/dev/null 2>&1; then
    exec python "$(dirname "$0")/check_encoding.py"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 "$(dirname "$0")/check_encoding.py"
else
    echo "[pre-commit] python 없음 - 인코딩 검사 건너뜀"
    exit 0
fi
