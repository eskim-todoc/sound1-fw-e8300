    },
    {
      "id": "SW-FW-RID-36",
      "sheet": "소프트웨어 입력 요구사항 사양서",
      "id_cell": "G41",
      "body_cell": "F41",
      "body": "\n특정 자극 출력\n",
      "upper_cell": "H41",
